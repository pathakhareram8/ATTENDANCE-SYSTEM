<script>
function padTo2Digits(num) {
  return num.toString().padStart(2, '0');
}

function formatDate(date) {
  return (
    [
      date.getFullYear(),
      padTo2Digits(date.getMonth() + 1),
      padTo2Digits(date.getDate()),
    ].join('-') +
    ' ' +
    [
      padTo2Digits(date.getHours()),
      padTo2Digits(date.getMinutes()),
      padTo2Digits(date.getSeconds()),
    ].join(':')
  );
}

function mark_present(roll_no){

  $.ajax({
    type:'post',
    data:{
        'roll_no':roll_no,
    'user_name':'<%= username %>',
    'dated':formatDate(new Date()),
    'present_flag':'P'
    },
    url:'/add_attendance',
    success:function(msg){console.log(msg);alert('Present marked');},
    error:function(err){console.log(err)}
        
    })
}

function mark_absent(roll_no){

$.ajax({
  type:'post',
  data:{
      'roll_no':roll_no,
  'user_name':'shivansh',
  'dated':formatDate(new Date()),
  'present_flag':'A'
  },
  url:'/add_attendance',
  success:function(msg){console.log(msg); alert('Absence marked');},
  error:function(err){console.log(err)}
      
  })
}



</script>
    
  
   
